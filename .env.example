# NVIDIA API Key
# Get yours at: https://build.nvidia.com/
NVAPI_KEY=nvapi-your-key-here

# Gemini API Key
# Get yours at: https://aistudio.google.com/
GEMINI_API_KEY=your-gemini-api-key-here

# Google Cloud / Vertex AI Credentials
# For Vertex AI Express Mode:
GOOGLE_CLOUD_API_KEY=your-google-cloud-api-key-here
# For standard GCP Service Account (file path or JSON string):
# GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json
# GCP_SERVICE_ACCOUNT_FILE=path/to/service-account.json
# GCP_SERVICE_ACCOUNT_JSON={"type": "service_account", ...}
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=us-central1
